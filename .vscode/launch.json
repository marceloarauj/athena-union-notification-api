{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Notification API (http)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Notification/Notification.csproj",
      "launchSettingsProfile": "http",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Notification API (https)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Notification/Notification.csproj",
      "launchSettingsProfile": "https",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Attach to Process",
      "type": "dotnet",
      "request": "attach"
    }
  ]
}
